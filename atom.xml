    <author>
      <name>YoungForest</name>
      <email>yangsen758@foxmail.com</email>
    </author>
    <category term="读后感" scheme="https://youngforest.github.io/categories/%E8%AF%BB%E5%90%8E%E6%84%9F/"/>
